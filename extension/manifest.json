{
  "manifest_version": 3,
  "name": "New Tab ASCII",
  "version": "0.1.0",
  "description": "Pestaña nueva con fondo ASCII animado (Rust + WebAssembly) y estadísticas de teclas dentro de Chrome.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "system.cpu", "system.memory", "system.storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/keyname.js", "content/keycount.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
